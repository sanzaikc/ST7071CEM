# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=coventry_research

# Crawler Configuration
CRAWL_DELAY=2.5
CRAWL_TIMEOUT=30
MAX_RETRIES=3
RESPECT_ROBOTS_TXT=false
USER_AGENT=CU-Research-SearchBot/1.0 (Educational Project)

# Target URL
TARGET_URL=https://pureportal.coventry.ac.uk/en/organisations/ics-research-centre-for-computational-science-and-mathematical-mo/publications/

# Scheduler Configuration
CRAWL_SCHEDULE_ENABLED=true
CRAWL_SCHEDULE_INTERVAL=daily
CRAWL_SCHEDULE_TIME=02:00

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
